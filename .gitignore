# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.pytest_cache/

# --- Secrets / credentials / config — NEVER commit ---
*.key
*.pem
*.p12
config.yaml
local_config.yaml
credentials*.json
service_account.json
.env
.env.*
!.env.example

# --- OS / editor ---
.DS_Store
Thumbs.db
.idea/
.vscode/

# --- Raw large Amazon dataset (re-downloadable) — do not commit ---
data/Gift_Cards.jsonl.gz

# --- Generated intermediate outputs (reproducible via the scripts) ---
data/*.jsonl
results/step2_report.txt
results/step2_results.json
results/step5_report.txt
results/step5_results.json
results/step6_report.txt
results/step6_results.json

# --- Temp screenshots ---
shot*.png
dashboard_screenshot_browser.png

